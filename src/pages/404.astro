---
import Link from '@/components/Link.astro'
import PageTitle from '@/components/PageTitle.astro'
import Layout from '@/layouts/Layout.astro'
---

<Layout title='Page not found' mainClass='py-32'>
  <section class='xl:w-full xl:max-w-2xl xl:mx-auto'>
    <div class='flex flex-col items-start space-y-6 px-5 xl:px-0'>
      <PageTitle>Page not found</PageTitle>
      <p class='text-lg max-w-xl text-blueGray-600'>
        This page doesn’t exist, or it moved.
      </p>
      <div class='flex gap-3'>
        <Link href='/' variant='button'>
          Go home
        </Link>
        <Link href='/blog/' variant='button'>
          Read the blog
        </Link>
      </div>
    </div>
  </section>
</Layout>
