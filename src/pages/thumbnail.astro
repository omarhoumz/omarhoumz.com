---
// Dev page: every Post's OG card, exactly as generated by /og/<slug>.png.
// Excluded from the sitemap.
import Layout from '@/layouts/Layout.astro'
import { getPosts } from '@/lib/posts'

const posts = await getPosts()
---

<Layout title='OG cards' bare>
  <main class='p-8 space-y-10 bg-gray-50 min-h-screen'>
    <h1 class='text-2xl font-bold text-brand-800'>OG cards</h1>
    {
      posts.map((post) => (
        <figure class='space-y-2'>
          <img
            src={new URL(post.ogCardUrl).pathname}
            alt={`OG card for ${post.title}`}
            width='1200'
            height='630'
            class='max-w-full h-auto rounded-lg shadow-md'
          />
          <figcaption class='text-sm text-gray-600'>
            <a class='underline' href={post.url}>{post.title}</a>
          </figcaption>
        </figure>
      ))
    }
  </main>
</Layout>
