---
import Link from '@/components/Link.astro'
import PageTitle from '@/components/PageTitle.astro'
import Layout from '@/layouts/Layout.astro'
import { twitterHandle } from '@/lib/site'
---

<Layout title='Contact Me' mainClass='py-32 space-y-12'>
  <section class='block xl:w-full xl:max-w-2xl xl:mx-auto'>
    <div class='flex flex-col items-start space-y-6 px-5 xl:px-0 text-blueGray-600'>
      <PageTitle>Contact Me</PageTitle>
      <p>If you want to get in touch, this is where I hang out often.</p>
      <div>
        <h2>Twitter:</h2>
        <Link external nofollow href='https://twitter.com/omarhoumz'>
          {twitterHandle}
        </Link>
      </div>
      <div>
        <h2>LinkedIn:</h2>
        <Link external nofollow href='https://linkedin.com/in/omarhoumz'>
          /in/omarhoumz
        </Link>
      </div>
      <div>
        <h2>Email:</h2>
        <Link external nofollow href='mailto:omarhoumz@gmail.com'>
          omarhoumz[at]gmail.com
        </Link>
      </div>
    </div>
  </section>
</Layout>
