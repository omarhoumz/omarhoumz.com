---
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import Link from '@/components/Link.astro'
import PostLink from '@/components/PostLink.astro'
import Pill from '@/components/Pill.astro'
import Sharer from '@/components/Sharer.astro'
import Layout from '@/layouts/Layout.astro'
import { getPosts } from '@/lib/posts'
import { twitterHandle } from '@/lib/site'

export const getStaticPaths = (async () => {
  const posts = await getPosts()
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }))
}) satisfies GetStaticPaths

const { post } = Astro.props
const { title, author, dateLabel } = post
const { Content } = await render(post.entry)

const currentUrl = new URL(post.url, Astro.site).href
const image = {
  url: post.ogCardUrl,
  alt: title,
  width: 1200,
  height: 630,
}
---

<Layout title={title} description={post.description} image={image}>
  <div class='py-8 lg:py-32 px-4 lg:px-0 max-w-2xl mx-auto'>
    <Link href='/blog/' class='inline-block text-xl mb-6'>
      ← Back
    </Link>
    <h1 class='text-4xl md:text-5xl text-blueGray-800 font-bold'>{title}</h1>
    <div class='mt-4 mb-8'>
      <span class='text-blueGray-500 mr-2'>
        ✍🏻 by <span class='capitalize'>{author}</span>
      </span>
      <Pill label={dateLabel} />
    </div>

    <article class='prose lg:prose-xl prose-slate'>
      <Content components={{ a: PostLink }} />
    </article>

    <Sharer url={currentUrl} title={title} twitterHandle={twitterHandle} />
  </div>
</Layout>
