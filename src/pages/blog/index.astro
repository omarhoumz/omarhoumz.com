---
import BlogListItem from '@/components/BlogListItem.astro'
import PageTitle from '@/components/PageTitle.astro'
import Layout from '@/layouts/Layout.astro'
import { getPosts } from '@/lib/posts'

const posts = await getPosts()
---

<Layout title='Blog' mainClass='py-32 space-y-12'>
  <section class='block xl:w-full xl:max-w-2xl xl:mx-auto'>
    <div class='flex flex-col items-start space-y-6 xl:px-0'>
      <PageTitle class='px-5'>Blog</PageTitle>
      <div>
        {posts.map((post) => (
          <BlogListItem
            title={post.title}
            excerpt={post.description}
            href={post.url}
            date={post.dateLabel}
            headingLevel={2}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
