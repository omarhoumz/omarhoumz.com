---
// Latin-only Inter subsets (~24 KB each vs ~100 KB for the full font).
import '@fontsource/inter/latin-400.css'
import '@fontsource/inter/latin-500.css'
import '@fontsource/inter/latin-700.css'
import interRegular from '@fontsource/inter/files/inter-latin-400-normal.woff2?url'
import '@/styles/global.css'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import Seo, { type OgImage } from '@/components/Seo.astro'
import { gaTrackingId } from '@/lib/site'

interface Props {
  title?: string
  description?: string
  image?: OgImage
  mainClass?: string
  /** Skip header/footer chrome (dev-only pages). */
  bare?: boolean
}

const { title, description, image, mainClass, bare = false } = Astro.props
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <Seo title={title} description={description} image={image} />
    <link
      rel='preload'
      href={interRegular}
      as='font'
      type='font/woff2'
      crossorigin
    />

    <link rel='icon' href='/favicon.ico' />
    <link
      rel='apple-touch-icon'
      sizes='180x180'
      href='/favicons/apple-touch-icon.png'
    />
    <link
      rel='icon'
      type='image/png'
      sizes='32x32'
      href='/favicons/favicon-32x32.png'
    />
    <link
      rel='icon'
      type='image/png'
      sizes='16x16'
      href='/favicons/favicon-16x16.png'
    />
    <link rel='manifest' href='/site.webmanifest' />
    <link
      rel='mask-icon'
      href='/favicons/safari-pinned-tab.svg'
      color='#2b5797'
    />
    <meta name='msapplication-TileColor' content='#2b5797' />
    <meta name='theme-color' content='#f4f4f4' />
    <link
      rel='alternate'
      type='application/rss+xml'
      title='Omar Houmz'
      href='/rss-feed.xml'
    />

    <!-- Global Site Tag (gtag.js) - Google Analytics -->
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${gaTrackingId}`}
    ></script>
    <script is:inline define:vars={{ gaTrackingId }}>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', gaTrackingId)
    </script>
  </head>
  <body>
    {bare ? (
      <slot />
    ) : (
      <div class='flex flex-col min-h-screen'>
        <Header />
        <main class:list={['flex-grow', mainClass]}>
          <slot />
        </main>
        <Footer />
      </div>
    )}
  </body>
</html>
