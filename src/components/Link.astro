---
import type { HTMLAttributes } from 'astro/types'

const colors = {
  blue: 'text-brand-500 hover:text-brand-700 hover:border-brand-700 text-current no-underline',
  dark: 'text-gray-800 hover:text-gray-900 hover:border-gray-900',
  current: 'hover:border-current text-current no-underline',
}

const btnBgColors = {
  blue: 'hover:text-brand-700 hover:bg-brand-50 focus:ring-brand-50',
  dark: 'hover:text-gray-900 hover:bg-gray-100 focus:ring-gray-100',
  current: '',
}

// Links inside running text need more than colour to stand out (WCAG 1.4.1).
const underlines = {
  blue: 'border-brand-500/25 hover:border-brand-700',
  dark: 'border-gray-800/25 hover:border-gray-900',
  current: 'border-current/25 hover:border-current',
}

interface Props extends HTMLAttributes<'a'> {
  href: string
  activeClassName?: string
  btnStyle?: boolean
  color?: keyof typeof colors
  external?: boolean
  nofollow?: boolean
  unstyled?: boolean
  /** Faint border underline, for links inside running text. */
  underline?: boolean
}

const {
  href,
  activeClassName = '',
  btnStyle = false,
  class: className,
  color = 'blue',
  external = false,
  nofollow = false,
  unstyled = false,
  underline = false,
  ...rest
} = Astro.props

const pathname = Astro.url.pathname
const isActive = href.startsWith('/blog/')
  ? pathname.startsWith('/blog/')
  : pathname === href

const classes = unstyled
  ? [className, { [activeClassName]: isActive && activeClassName }]
  : [
      {
        'pb-0.5 pt-1 border-b-2': !btnStyle,
        'border-transparent': !btnStyle && !underline,
        [underlines[color]]: !btnStyle && underline,
        'inline-flex items-center h-8 px-3 uppercase text-sm font-bold rounded border border-current focus-visible:ring-[3px] focus-visible:ring-brand-50 focus-visible:outline-none':
          btnStyle,
        [btnBgColors[color]]: btnStyle,
        [activeClassName]: isActive && activeClassName,
      },
      colors[color],
      'transition-color duration-75',
      className,
    ]

// Trimmed so formatter line breaks around <slot /> never leak into inline text.
const content = (await Astro.slots.render('default')).trim()

const externalProps = external
  ? {
      target: '_blank',
      rel: ['noopener', 'noreferrer', nofollow && 'nofollow']
        .filter(Boolean)
        .join(' '),
    }
  : {}
---

<a
  href={href}
  class:list={classes}
  {...externalProps}
  {...rest}
  set:html={content}
/>
