---
// A Project card. The title links to the live site (or the source when there is none)
// and is stretched over the card, so the whole card stays clickable; the "Live site" /
// "Source" row sits above that overlay as separate links.
import Link from './Link.astro'
import Pill from './Pill.astro'
import { projectStatuses, type Project } from '@/lib/projects'

type Props = Project & { headingLevel?: 2 | 3 }
const {
  icon,
  title,
  description,
  live,
  repo,
  status,
  headingLevel = 3,
} = Astro.props
const Heading = `h${headingLevel}` as const
const primary = live ?? repo
const secondary = [
  live && { href: live, label: 'Live site' },
  repo && { href: repo, label: 'Source' },
].filter(Boolean) as { href: string; label: string }[]
---

<article
  class:list={[
    'group relative flex flex-col gap-2 p-6 border border-brand-50 rounded-lg transition-shadow',
    '[--shadow:0_1px_16px_-4px_var(--color-brand-100)]',
    'hover:shadow-(--shadow) has-[a:focus-visible]:shadow-(--shadow) has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-brand-100 has-[a:focus-visible]:-outline-offset-2',
  ]}
>
  <Heading class='flex items-center gap-3 text-lg'>
    {status && status !== projectStatuses.active && (
      <Pill label={projectStatuses[status]} />
    )}
    {icon && (
      <img
        src={icon}
        class='border border-gray-100 rounded-md'
        width='28'
        height='28'
        alt=''
        style='max-width: 100%; height: auto'
      />
    )}
    <Link
      href={primary!}
      variant='card'
      class="font-bold transition-colors text-brand-800 group-hover:text-brand-600 focus:outline-none after:absolute after:inset-0 after:content-['']"
    >
      {title}
    </Link>
    <span class='text-gray-300 transition-colors group-hover:text-gray-400' aria-hidden='true'>
      <svg
        class='w-4 h-4'
        fill='none'
        stroke='currentColor'
        viewBox='0 0 24 24'
        xmlns='http://www.w3.org/2000/svg'
      >
        <path
          stroke-linecap='round'
          stroke-linejoin='round'
          stroke-width='2'
          d='M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14'
        ></path>
      </svg>
    </span>
  </Heading>
  <p class='max-w-2xl text-gray-500'>{description}</p>
  {secondary.length > 0 && (
    <p class='relative z-1 flex gap-4 text-sm'>
      {secondary.map(({ href, label }) => (
        <Link href={href} color='brand'>
          {label}
        </Link>
      ))}
    </p>
  )}
</article>
