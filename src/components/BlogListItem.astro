---
import Link from './Link.astro'
import Pill from './Pill.astro'

interface Props {
  title: string
  href: string
  date?: string
  excerpt?: string
  class?: string
}
const { title, href, date, excerpt, class: className } = Astro.props
---

<Link
  href={href}
  unstyled
  class:list={[
    'flex flex-col items-start p-4 group hover:bg-[#fbfbff]',
    className,
  ]}
>
  {date && <Pill label={date} />}
  <h3 class='text-2xl text-blueGray-700 font-bold mt-1.5'>{title}</h3>
  {excerpt && (
    <p class='text-lg text-blueGray-700 font-light my-2 max-w-prose'>
      {excerpt}
    </p>
  )}
  <p class='group-hover:text-brand-700 text-lg'>Read →</p>
</Link>
