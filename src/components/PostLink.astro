---
// `a` override for MDX posts.
// - Absolute URLs open in a new tab.
// - Links get the brand colour; Link's `blue` style also sets `text-current`,
//   which otherwise wins and renders links in the body text colour.
// - Heading anchors (`#id`, from rehype-autolink-headings) keep the heading colour.
import Link from './Link.astro'

interface Props {
  href: string
}
const { href, ...rest } = Astro.props
const isAnchor = href.startsWith('#')
---

<Link
  href={href}
  external={/^https?:\/\//.test(href)}
  underline={!isAnchor}
  class:list={{ 'text-brand-500! hover:text-brand-700!': !isAnchor }}
  {...rest}
>
  <slot />
</Link>
