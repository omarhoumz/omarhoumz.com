---
// `a` override for MDX posts: brand-coloured, underlined text links.
// Heading anchors (`#id`, from rehype-autolink-headings) keep the heading's look.
import Link from './Link.astro'

interface Props {
  href: string
}
const { href, ...rest } = Astro.props
const isAnchor = href.startsWith('#')
---

<Link
  href={href}
  color={isAnchor ? 'plain' : 'brand'}
  underline={!isAnchor}
  {...rest}><slot /></Link
>
