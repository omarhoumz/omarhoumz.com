---
interface Props {
  url: string
  title: string
  twitterHandle: string
}
const { url, title, twitterHandle } = Astro.props

const twitterUrl = `https://twitter.com/intent/tweet?${new URLSearchParams({
  url,
  text: title,
  via: twitterHandle.replace('@', ''),
})}`
const facebookUrl = `https://www.facebook.com/sharer/sharer.php?${new URLSearchParams({ u: url })}`

const linkClass =
  'mx-1 px-1 pb-0.5 pt-1 leading-none border-b-2 border-transparent transition-colors hover:border-current hover:text-brand-700 focus:bg-brand-50'
---

<div class='mt-24 bg-brand-50/30 border-t-2 border-b-2 border-brand-50 py-8 px-4 space-y-3 text-xl'>
  <p>
    <strong>Thank you</strong> for reading.
  </p>
  <p>
    If you think that someone else could also benefit from this post, take a
    moment to <strong>share it</strong>. Or even bookmark it for later.
  </p>
  <div class='text-brand-500'>
    <small class='mr-2 text-blueGray-600'>Share post</small>
    <a
      href={twitterUrl}
      target='_blank'
      rel='noopener noreferrer'
      class={linkClass}
    >
      Twitter
    </a>
    <a
      href={facebookUrl}
      target='_blank'
      rel='noopener noreferrer'
      class={linkClass}
    >
      Facebook
    </a>
  </div>
</div>
