---
import Link from './Link.astro'

const currentYear = new Date().getFullYear()
---

<footer class='text-blueGray-700 text-center space-y-1 py-6 md:pt-12 md:pb-28 px-4 md:px-0'>
  <p class='font-bold text-sm'>Omar Houmz &copy; {currentYear}</p>
  <small class='inline-block'>
    This site is built with
    <Link color='dark' href='https://astro.build/'>Astro</Link>
    and hosted on
    <Link color='dark' href='https://vercel.com/'>Vercel</Link>.
    The source code is hosted on
    <Link color='dark' href='https://github.com/omarhoumz/omarhoumz.com'>Github</Link>.
  </small>
</footer>
